# --- Server ---
NODE_ENV=development
PORT=4000
# Public URL of the Next.js frontend (CORS origin + links in emails)
WEB_URL=http://localhost:3000
# Public URL of this API (used in Swagger + logs)
API_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://expense:expense@localhost:5432/expense_tracker?schema=public

# --- Auth ---
# Generate strong values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Access token lifetime in seconds (default 15 minutes)
JWT_ACCESS_TTL=900
# Refresh token lifetime in days
JWT_REFRESH_TTL_DAYS=30
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false

# --- Recurring transactions ---
# Set to false to disable the in-process scheduler (e.g. when running several API replicas
# and processing recurring transactions from a single worker instead)
RECURRING_SCHEDULER_ENABLED=true

# --- Swagger ---
SWAGGER_ENABLED=true
